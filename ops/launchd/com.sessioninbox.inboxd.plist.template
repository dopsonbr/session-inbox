<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sessioninbox.inboxd</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{HOME}}/bin/inboxd</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SESSION_INBOX_HOME</key>
    <string>{{HOME}}</string>
    <key>SESSION_INBOX_UI_DIR</key>
    <string>{{HOME}}/ui</string>
    <key>PATH</key>
    <string>{{PATH}}</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>{{HOME}}/inboxd.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/inboxd.log</string>
</dict>
</plist>
